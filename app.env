# The app's identity: the one place scripts read it from.
# Change it with scripts/rename_app.sh, never by hand: the script also
# replaces these values in every file of the repo.
APP_NAME="MyApp"
APP_PACKAGE="my_app"
APP_SLUG="myapp"
APP_ID="com.example.myapp"
FIREBASE_PROJECT="my-firebase-project"
