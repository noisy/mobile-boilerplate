.DS_Store
# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/
*.iml
.idea/
.vscode/
*.swp

# Signing keys and credentials: they live on your machine and in GitHub
# secrets, never in the repo.
*.keystore
*.jks
*.p8
*.p12
*.pem
*.mobileprovision
*.cer
.env
.env.*
key.properties
local.properties
certs.txt

# Firebase config files are downloaded per app (see firebase/README.md).
# Only the templates are committed.
google-services.json
GoogleService-Info.plist
!firebase/*.template.*

# Platform folders are generated by `flutter create` in scripts/ci/prepare_*.sh.
/android/
/ios/
/web/
/macos/
/linux/
/windows/

# Build outputs copied to the repo root by scripts/ci/
*.apk
*.aab
*.ipa

# Golden screenshots are rendered for review (CI artifact), not committed
test/screenshots/goldens/

# Generated by flutter gen-l10n on pub get
lib/l10n/gen/

# Parallel work: one git worktree per task
.worktree/
__pycache__/
